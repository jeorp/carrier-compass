---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import '../styles/home.css';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = await getCollection('blog');
const latestPosts = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const categories = ['転職', 'スキルアップ', '副業', '働き方'];



const moments = [
	{
		situation: '今日は、少し疲れたな',
		description: '休むための予定まで、がんばらなくていい。何かを足す前に、ひとつ減らしてみる。',
		label: '休むことの読みもの',
		href: `${base}/blog/tired-day-reset-routine/`,
		motif: 'cup',
	},
	{
		situation: '人に合わせすぎた日',
		description: '相手の気持ちを考えてばかりだった日。自分の気持ちにも、そっと目を向ける。',
		label: '気持ちに寄り添う読みもの',
		href: `${base}/blog/too-considerate-exhaustion/`,
		motif: 'leaf',
	},
	{
		situation: '明日のことが気になる夜',
		description: 'まだ起きていないことを考えてしまう夜に。明日の準備と、今夜の時間を分けてみる。',
		label: '夜に読む読みもの',
		href: `${base}/blog/work-night-before-dread/`,
		motif: 'moon',
	},
];

const restPosts = [
	{ slug: 'nature-walk-psychological-effects', theme: '自然と過ごす', excerpt: '緑のある場所へ、少し寄り道。散歩と考えごとの研究から。' },
	{ slug: 'music-relaxation-effects', theme: '音楽を聴く', excerpt: '今夜の一曲は、好きなもので。音楽の効果と、心地よい聴き方。' },
	{ slug: 'micro-break-psychology', theme: '小さく休む', excerpt: '数分の空白も、そのままに。短い休憩と疲労感のお話。' },
	{ slug: 'self-compassion-small-practice', theme: '自分への言葉', excerpt: '失敗した日にも、思いやりを。自分に向ける言葉の小さな例。' },
].map((item) => {
	const post = posts.find((post) => post.id === item.slug);
	if (!post) throw new Error(`Rest article not found: ${item.slug}`);
	return { ...item, title: post.data.title };
});

const featuredPosts = [
	{ situation: '自分のペースを思い出す', slug: 'working-harder-lost-my-style' },
	{ situation: '休日に、仕事が頭を離れないとき', slug: 'weekend-work-thoughts' },
	{ situation: '弱音をしまい込んだ日に', slug: 'work-cant-show-weakness' },
	{ situation: '暮らしと働き方のあいだで', slug: 'work-qol-values' },
].map((item) => {
	const post = posts.find((post) => post.id === item.slug);
	if (!post) throw new Error(`Featured article not found: ${item.slug}`);
	return { ...item, title: post.data.title };
});

---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="dns-prefetch" href="https://www14.a8.net" />

	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero" aria-labelledby="home-title">
				<div class="hero-copy">
					<p class="eyebrow">働く毎日に、ひと息つける場所。</p>
					<h1 id="home-title">今日は、<br /><span>ひと息つくだけでも。</span></h1>
					<p class="hero-description">あたたかい飲みものと、短い読みもの。<br />仕事のこと、自分のこと。<br />答えを急がず、ゆっくりと。</p>
					<a class="hero-cta" href="#moments">今の気分で、ひとつ読む <span aria-hidden="true">↓</span></a>
				</div>
			</section>

			<div class="welcome-note">
				<span class="note-line" aria-hidden="true"></span>
				<p>がんばった日も、うまくいかなかった日も。<br />ここでは、あなたのペースで。</p>
				<span class="note-line" aria-hidden="true"></span>
			</div>

			<!-- Moments -->
			<section class="moments" id="moments">
				<div class="section-heading"><div><p class="eyebrow">FOR YOUR MOOD</p><h2>今の気分に、そっと寄り添う。</h2></div><span class="section-note">気になる読みものから、どうぞ。</span></div>
				<div class="moment-list">
					{moments.map((m) => (
						<a class="moment-card" href={m.href}>
							<svg class="moment-motif" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								{m.motif === 'cup' && <><path d="M12 22h21v9a8 8 0 0 1-8 8h-5a8 8 0 0 1-8-8zM33 24h3a5 5 0 0 1 0 10h-3M8 42h30M19 16c-5-5 5-6 0-11M27 16c-5-5 5-6 0-11" /></>}
								{m.motif === 'leaf' && <><path d="M13 39c2-13 10-22 23-29M18 29C7 13 21 6 39 7c1 18-5 30-21 22ZM22 24l-1-9m6 5 8 1" /></>}
								{m.motif === 'moon' && <><path d="M34 32A17 17 0 0 1 17 9a17 17 0 1 0 17 23Z" /><path d="M32 8v8m-4-4h8m4 7v4m-2-2h4" /></>}
							</svg><h3 class="moment-situation">{m.situation}</h3>
							<p class="moment-quote">{m.description}</p>
							<div class="moment-action">{m.label}<span aria-hidden="true">↗</span></div>
						</a>
					))}
				</div>
			</section>

			<section class="rest-reading" id="rest-reading" aria-labelledby="rest-title">
				<div class="section-heading"><div><p class="eyebrow">A LITTLE REST</p><h2 id="rest-title">こころの休息、小さな心理学。</h2></div><a class="all-link" href={`${base}/blog/tag/こころの休息/`}>このテーマを読む →</a></div>
				<p class="rest-intro">自然や音楽、自分への言葉。ほっとする時間を、研究の話といっしょに。</p>
				<div class="rest-grid">
					{restPosts.map((post) => (
						<a class="rest-card" href={`${base}/blog/${post.slug}/`}>
							<span class="rest-theme">{post.theme}</span>
							<h3>{post.title}</h3>
							<p>{post.excerpt}</p>
							<span class="rest-read">ゆっくり読む <span aria-hidden="true">↗</span></span>
						</a>
					))}
				</div>
			</section>

			<!-- Featured guides -->
			<section class="featured-guides">
				<div class="section-heading"><div><p class="eyebrow">SLOW READING</p><h2>ひと息つきながら、読みたいこと。</h2></div><span class="section-note">毎日の気持ちを綴る、読みもの</span></div>
				<div class="featured-guides-list">
					{featuredPosts.map((a, index) => (
						<a class="featured-guides-card" href={`${base}/blog/${a.slug}/`}>
							<span class="story-index">0{index + 1}</span><div class="featured-guides-situation">{a.situation}</div>
							<h3 class="featured-guides-title">{a.title}</h3><span class="story-arrow" aria-hidden="true">↗</span>
						</a>
					))}
				</div>
				<a class="all-link" href={`${base}/blog/`}>すべての記事を見る →</a>
			</section>


			<section class="latest">
        <div class="section-heading"><div><p class="eyebrow">NEW STORIES</p><h2>新しく綴ったこと</h2></div><a class="all-link" href={`${base}/blog/`}>記事一覧へ →</a></div>
        <div class="latest-list">{latestPosts.map(post => <a class="latest-card" href={`${base}/blog/${post.id}/`}><div class="latest-meta"><span>{post.data.category}</span><FormattedDate date={post.data.pubDate} /></div><h3>{post.data.title}</h3><span class="latest-read">記事を読む <span aria-hidden="true">↗</span></span></a>)}</div>
      </section>
      <!-- Categories -->
			<section class="categories">
				<h2 class="section-title">テーマから探す</h2>
				<div class="category-list">
					{categories.map((cat) => (
						<a href={`${base}/blog/category/${cat}/`}>{cat}</a>
					))}
				</div>
			</section>

			<!-- Coffee advertisement -->
			<section class="coffee-ad">
				<h2 class="section-title">読みもののおともに</h2>
				<a class="coffee-ad-card" href="https://px.a8.net/svt/ejp?a8mat=4AZJGB+CI4HE+5UFU+5YJRM" rel="nofollow" target="_blank">
					<div class="coffee-ad-icon">☕</div>
					<div class="coffee-ad-body">
						<div class="coffee-ad-label">コーヒーの広告<span class="coffee-ad-pr">PR</span></div>
						<p class="coffee-ad-name">ブルーボトルコーヒー 公式オンラインストア</p>
						<p class="coffee-ad-desc">自宅で飲むコーヒーを探している方へ。商品や購入条件は公式オンラインストアで確認できます。</p>
					</div>
					<div class="coffee-ad-arrow">→</div>
				</a>
				<img src="https://www14.a8.net/0.gif?a8mat=4AZJGB+CI4HE+5UFU+5YJRM" width="1" height="1" alt="" style="display:none;" />
			</section>

		</main>
		<Footer />
	</body>
</html>
