---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import '../styles/home.css';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = await getCollection('blog');
const latestPosts = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const categories = ['転職', 'スキルアップ', '副業', '働き方'];



const moments = [
	{
		situation: '人間関係で、疲れている',
		description: '気を遣いすぎたり、抱え込んだり。今の負担を言葉にするところから。',
		label: '気持ちを整理する',
		href: `${base}/blog/too-considerate-exhaustion/`,
	},
	{
		situation: 'この仕事を続けるか迷う',
		description: '悪い会社ではないけれど、何かが違う。その違和感を、一つずつ確かめる。',
		label: '働き方を見つめ直す',
		href: `${base}/blog/good-company-feels-wrong/`,
	},
	{
		situation: '次に何をすればいい？',
		description: '誰かに相談したい。でも、何を話せばいいか分からないときの準備に。',
		label: '相談の準備をする',
		href: `${base}/blog/career-consultation-what-to-say/`,
	},
];

const featuredPosts = [
	{ situation: '抱え込みすぎないために', slug: 'workplace-nice-person-exhaustion' },
	{ situation: '今の職場でできること', slug: 'work-cant-show-weakness' },
	{ situation: '転職を決める、その前に', slug: 'career-consult-no-transfer' },
	{ situation: '環境を変える準備', slug: 'job-change-preparation' },
].map((item) => {
	const post = posts.find((post) => post.id === item.slug);
	if (!post) throw new Error(`Featured article not found: ${item.slug}`);
	return { ...item, title: post.data.title };
});

---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="dns-prefetch" href="https://www14.a8.net" />

	</head>
	<body>
		<Header />
		<main class="home">
			<!-- Hero -->
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">仕事と、自分と、これから。</p>
					<h1>今の仕事と、<br /><span>これからの自分。</span></h1>
					<p class="hero-description">仕事がしんどい。でも、辞めるべきかは分からない。<br />気持ちの整理から、働き方の見直しまで。<br />自分に合う次の一歩を、ここから。</p>
					<a class="hero-cta" href="#moments">今の悩みから記事を探す <span aria-hidden="true">→</span></a>
					<a class="hero-secondary" href={`${base}/blog/`}>すべての記事を見る <span aria-hidden="true">↗</span></a>
				</div>
				<figure class="hero-visual" aria-label="自分のペースで、進む方向を考える羅針盤">
					<div class="compass-heading"><span>CAREER COMPASS</span><span aria-hidden="true">↗</span></div>
					<svg class="compass-art" viewBox="0 0 440 290" fill="none" aria-hidden="true">
						<path d="M-20 235C60 170 81 280 180 206S327 72 460 106" stroke="var(--compass-line)" stroke-width="1.5" stroke-dasharray="5 8" />
						<path d="M-20 258C62 193 102 300 199 223S344 90 460 125" stroke="var(--compass-line)" opacity=".45" />
						<circle cx="220" cy="145" r="117" stroke="var(--compass-line)" />
						<circle cx="220" cy="145" r="99" stroke="var(--compass-line)" stroke-dasharray="1 9" />
						<circle cx="220" cy="145" r="80" fill="var(--paper)" stroke="var(--compass-line)" />
						<path d="M220 15V35M220 255V275M90 145H110M330 145H350" stroke="var(--accent)" />
						<path d="M149 74L158 83M282 207L291 216M149 216L158 207M282 83L291 74" stroke="var(--compass-line)" />
						<path d="M266 80L236 161L174 210L204 129Z" fill="var(--surface)" stroke="var(--accent)" stroke-width="1.5" />
						<path d="M266 80L204 129L236 161Z" fill="var(--accent)" />
						<circle cx="220" cy="145" r="7" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
						<circle cx="55" cy="216" r="5" fill="var(--ochre)" />
						<circle cx="391" cy="108" r="5" fill="var(--accent)" />
					</svg>
					<figcaption>進む方向は、自分のペースで。</figcaption>
					<div class="compass-steps"><span>01 気持ちを整理する</span><span>02 選択肢を知る</span><span>03 一歩を選ぶ</span></div>
				</figure>
			</section>

			<!-- Moments -->
			<section class="moments" id="moments">
				<div class="section-heading"><div><p class="eyebrow">START HERE</p><h2>今、気になっていることは？</h2></div><span class="section-note">うまく言葉にできなくても、大丈夫。</span></div>
				<div class="moment-list">
					{moments.map((m, index) => (
						<a class="moment-card" href={m.href}>
							<span class="moment-number">0{index + 1}</span><h3 class="moment-situation">{m.situation}</h3>
							<p class="moment-quote">{m.description}</p>
							<div class="moment-action">{m.label}<span aria-hidden="true">↗</span></div>
						</a>
					))}
				</div>
			</section>

			<!-- Featured guides -->
			<section class="featured-guides">
				<div class="section-heading"><div><p class="eyebrow">READ & REFLECT</p><h2>自分に合う働き方を考える。</h2></div><span class="section-note">整理や行動に使える、4つのガイド</span></div>
				<div class="featured-guides-list">
					{featuredPosts.map((a, index) => (
						<a class="featured-guides-card" href={`${base}/blog/${a.slug}/`}>
							<span class="story-index">0{index + 1}</span><div class="featured-guides-situation">{a.situation}</div>
							<h3 class="featured-guides-title">{a.title}</h3><span class="story-arrow" aria-hidden="true">↗</span>
						</a>
					))}
				</div>
				<a class="all-link" href={`${base}/blog/`}>すべての記事を見る →</a>
			</section>


			<section class="latest">
        <div class="section-heading"><div><p class="eyebrow">NEW STORIES</p><h2>新しく届いた読みもの</h2></div><a class="all-link" href={`${base}/blog/`}>記事一覧へ →</a></div>
        <div class="latest-list">{latestPosts.map(post => <a class="latest-card" href={`${base}/blog/${post.id}/`}><div class="latest-meta"><span>{post.data.category}</span><FormattedDate date={post.data.pubDate} /></div><h3>{post.data.title}</h3><span class="latest-read">記事を読む <span aria-hidden="true">↗</span></span></a>)}</div>
      </section>
      <!-- Categories -->
			<section class="categories">
				<h2 class="section-title">テーマから探す</h2>
				<div class="category-list">
					{categories.map((cat) => (
						<a href={`${base}/blog/category/${cat}/`}>{cat}</a>
					))}
				</div>
			</section>

			<!-- Coffee advertisement -->
			<section class="coffee-ad">
				<h2 class="section-title">コーヒーの広告</h2>
				<a class="coffee-ad-card" href="https://px.a8.net/svt/ejp?a8mat=4AZJGB+CI4HE+5UFU+5YJRM" rel="nofollow" target="_blank">
					<div class="coffee-ad-icon">☕</div>
					<div class="coffee-ad-body">
						<div class="coffee-ad-label">コーヒーのサービス紹介<span class="coffee-ad-pr">PR</span></div>
						<p class="coffee-ad-name">ブルーボトルコーヒー 公式オンラインストア</p>
						<p class="coffee-ad-desc">自宅で飲むコーヒーを探している方へ。商品や購入条件は公式オンラインストアで確認できます。</p>
					</div>
					<div class="coffee-ad-arrow">→</div>
				</a>
				<img src="https://www14.a8.net/0.gif?a8mat=4AZJGB+CI4HE+5UFU+5YJRM" width="1" height="1" alt="" style="display:none;" />
			</section>

		</main>
		<Footer />
	</body>
</html>
