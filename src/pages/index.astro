---
import { Image } from 'astro:assets';
import JournalIllustration from '../assets/journal-woman-window.png';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import '../styles/home.css';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = await getCollection('blog');
const latestPosts = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const categories = ['転職', 'スキルアップ', '副業', '働き方'];



const moments = [
	{
		situation: '気を遣いすぎて、疲れた日',
		description: '自分のことは、いつも後回し。抱え込んでいることを、少しずつほどいてみる。',
		author: 'Yuki',
		href: `${base}/blog/too-considerate-exhaustion/`,
	},
	{
		situation: '「私でいいのかな」と思う日',
		description: '新しい役割も、誰かの期待も。自信が持てない気持ちから、一緒に考える。',
		author: 'Yuki',
		href: `${base}/blog/female-leader-anxiety/`,
	},
	{
		situation: 'これからの暮らしに迷う日',
		description: '仕事も、仕事以外の大切なことも。自分が望むこれからを、ゆっくり見つめる。',
		author: 'Yuki',
		href: `${base}/blog/women-work-marriage-dilemma/`,
	},
];

const featuredYuki = [
	{ situation: '職場の人間関係', slug: 'too-considerate-exhaustion' },
	{ situation: '自分らしいキャリア', slug: 'female-leader-anxiety' },
	{ situation: '仕事とこれからの暮らし', slug: 'women-work-marriage-dilemma' },
	{ situation: '自分との向き合い方', slug: 'comparing-with-coworkers' },
].map((item) => {
	const post = posts.find((post) => post.id === item.slug);
	if (!post) throw new Error(`Featured article not found: ${item.slug}`);
	return { ...item, title: post.data.title };
});

---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="dns-prefetch" href="https://www14.a8.net" />
		<link rel="dns-prefetch" href="https://www15.a8.net" />
		<link rel="dns-prefetch" href="https://www12.a8.net" />

	</head>
	<body>
		<Header />
		<main class="home">
			<!-- Hero -->
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">わたしと、仕事と、これから。</p>
					<h1>がんばる毎日に、<br /><span>わたしを想う時間。</span></h1>
					<p class="hero-description">仕事は大切。でも、わたしの気持ちも大切。<br />人間関係、キャリア、これからの暮らし。<br />迷う日も、自分のペースで考えていこう。</p>
					<a class="hero-cta" href="#moments">今の気持ちに合う記事を読む <span aria-hidden="true">→</span></a>
					<a class="hero-secondary" href={`${base}/blog/`}>すべての記事を見る <span aria-hidden="true">↗</span></a>
				</div>
				<figure class="hero-visual">
					<Image src={JournalIllustration} alt="やわらかな日差しの窓辺で、ノートに思いを書く女性のイラスト" widths={[480, 800, 1200]} sizes="(max-width: 720px) calc(100vw - 40px), 50vw" width={900} format="webp" loading="eager" fetchpriority="high" />
					<figcaption>ひと息ついて、わたしのペースで。</figcaption>
				</figure>
			</section>

			<!-- Moments -->
			<section class="moments" id="moments">
				<div class="section-heading"><div><p class="eyebrow">HOW ARE YOU TODAY?</p><h2>今日は、どんな気持ち？</h2></div><span class="section-note">うまく言葉にできなくても、大丈夫。</span></div>
				<div class="moment-list">
					{moments.map((m, index) => (
						<a class="moment-card" href={m.href}>
							<span class="moment-number">0{index + 1}</span><h3 class="moment-situation">{m.situation}</h3>
							<p class="moment-quote">{m.description}</p>
							<div class="moment-attribution">{m.author}<span aria-hidden="true">↗</span></div>
						</a>
					))}
				</div>
			</section>

			<!-- Featured Yuki -->
			<section class="featured-yuki">
				<div class="section-heading"><div><p class="eyebrow">EDITOR’S LETTER</p><h2>わたしらしく働くために。</h2></div><span class="section-note">気持ちに寄り添う、4つの読みもの</span></div>
				<div class="featured-yuki-list">
					{featuredYuki.map((a, index) => (
						<a class="featured-yuki-card" href={`${base}/blog/${a.slug}/`}>
							<span class="story-index">0{index + 1}</span><div class="featured-yuki-situation">{a.situation}</div>
							<h3 class="featured-yuki-title">{a.title}</h3><span class="story-arrow" aria-hidden="true">↗</span>
						</a>
					))}
				</div>
				<a class="all-link" href={`${base}/blog/author/yuki/`}>Yukiの記事をすべて見る →</a>
			</section>


			<section class="latest">
        <div class="section-heading"><div><p class="eyebrow">NEW STORIES</p><h2>新しく届いた読みもの</h2></div><a class="all-link" href={`${base}/blog/`}>記事一覧へ →</a></div>
        <div class="latest-list">{latestPosts.map(post => <a class="latest-card" href={`${base}/blog/${post.id}/`}><div class="latest-meta"><span>{post.data.category}</span><FormattedDate date={post.data.pubDate} /></div><h3>{post.data.title}</h3><span class="latest-read">記事を読む <span aria-hidden="true">↗</span></span></a>)}</div>
      </section>
      <!-- Categories -->
			<section class="categories">
				<h2 class="section-title">テーマから探す</h2>
				<div class="category-list">
					{categories.map((cat) => (
						<a href={`${base}/blog/category/${cat}/`}>{cat}</a>
					))}
				</div>
			</section>

			<!-- Yuki's pick -->
			<section class="yuki-pick">
				<h2 class="section-title">コーヒーの広告</h2>
				<a class="yuki-pick-card" href="https://px.a8.net/svt/ejp?a8mat=4AZJGB+CI4HE+5UFU+5YJRM" rel="nofollow" target="_blank">
					<div class="yuki-pick-icon">☕</div>
					<div class="yuki-pick-body">
						<div class="yuki-pick-label">コーヒーのサービス紹介<span class="yuki-pick-pr">PR</span></div>
						<p class="yuki-pick-name">ブルーボトルコーヒー 公式オンラインストア</p>
						<p class="yuki-pick-desc">自宅で飲むコーヒーを探している方へ。商品や購入条件は公式オンラインストアで確認できます。</p>
					</div>
					<div class="yuki-pick-arrow">→</div>
				</a>
				<img src="https://www14.a8.net/0.gif?a8mat=4AZJGB+CI4HE+5UFU+5YJRM" width="1" height="1" alt="" style="display:none;" />
			</section>

			<!-- kz's pick -->
			<section class="kz-pick">
				<h2 class="section-title">kzのおすすめ</h2>
				<a class="kz-pick-card" href="https://px.a8.net/svt/ejp?a8mat=4AZJGB+N7XDE+2OM2+ZQ80I" rel="nofollow" target="_blank">
					<div class="kz-pick-icon">🛠️</div>
					<div class="kz-pick-body">
						<div class="kz-pick-label">副業プラットフォームの紹介<span class="kz-pick-pr">PR</span></div>
						<p class="kz-pick-name">クラウドワークス テック</p>
						<p class="kz-pick-desc">エンジニア向け案件が充実。フリーランス転向を考えているなら、まず案件の相場感を掴むのに使える。</p>
					</div>
					<div class="kz-pick-arrow">→</div>
				</a>
				<img width="1" height="1" src="https://www15.a8.net/0.gif?a8mat=4AZJGB+N7XDE+2OM2+ZQ80I" alt="" style="display:none;" />
				<a class="kz-pick-card" href="https://px.a8.net/svt/ejp?a8mat=4AZJGB+3KMEQ+5B0Y+HVNAP" rel="nofollow" target="_blank">
					<div class="kz-pick-icon">🚀</div>
					<div class="kz-pick-body">
						<div class="kz-pick-label">転職サービスの紹介<span class="kz-pick-pr">PR</span></div>
						<p class="kz-pick-name">TechGo（テックゴー）</p>
						<p class="kz-pick-desc">ITエンジニア向けのハイクラス転職サービス。年収アップを狙うなら選択肢に入れておいて損はない。</p>
					</div>
					<div class="kz-pick-arrow">→</div>
				</a>
				<img width="1" height="1" src="https://www12.a8.net/0.gif?a8mat=4AZJGB+3KMEQ+5B0Y+HVNAP" alt="" style="display:none;" />
			</section>
		</main>
		<Footer />
	</body>
</html>
