---
import { getCollection } from 'astro:content';
import '../../../../styles/archive.css';
import BaseHead from '../../../../components/BaseHead.astro';
import Footer from '../../../../components/Footer.astro';
import FormattedDate from '../../../../components/FormattedDate.astro';
import Header from '../../../../components/Header.astro';
import { SITE_TITLE } from '../../../../consts';

const authors = ['yuki', 'syun', 'kz'] as const;
const authorLabels: Record<string, string> = {
	syun: '💼 Syun',
	yuki: '☕ Yuki',
	kz: '🛠️ kz',
};
const categories = ['転職', 'スキルアップ', '副業', '働き方'] as const;

type AuthorProfile = {
	name: string;
	role: string;
	bio: string;
};
const authorProfiles: Record<string, AuthorProfile> = {
	syun: {
		name: 'Syun',
		role: '転職・キャリア',
		bio: '転職やキャリアの選び方をテーマに、迷いを整理し、次の一歩を考えるヒントを届けます。',
	},
	yuki: {
		name: 'Yuki',
		role: '職場の人間関係・働き方',
		bio: '職場の人間関係や働き方の迷いをテーマに、気持ちの整理や相談のヒントを届けます。',
	},
	kz: {
		name: 'kz',
		role: '開発・運営',
		bio: 'サイトの開発・運営を担当。エンジニアのキャリアや副業をテーマに記事を編集しています。',
	},
};

export async function getStaticPaths({ paginate }: { paginate: Function }) {
	const authors = ['yuki', 'syun', 'kz'] as const;
	const posts = await getCollection('blog');
	return authors.flatMap((author) => {
		const filtered = posts
			.filter((p) => p.data.author === author)
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		return paginate(filtered, { params: { author }, pageSize: 8 });
	});
}

const { author } = Astro.params;
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const readingTime = (body: string) => Math.max(1, Math.ceil(body.length / 500));
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title={page.currentPage === 1 ? `${authorLabels[author]} | ${SITE_TITLE}` : `${authorLabels[author]} — ${page.currentPage}ページ目 | ${SITE_TITLE}`}
			description={`${authorLabels[author]}の記事一覧`}
			noindex={true}
		/>

	</head>
	<body>
		<Header />
		<main class="archive">
      <div class="archive-heading"><p>THE JOURNAL</p><h1>{`${authorProfiles[author]?.name ?? author}の記事`}</h1><span>働く毎日と、これからを考える読みもの。</span></div>
			<section>
				{authorProfiles[author] && (
					<div class="author-profile">
						<div class="author-avatar">{authorLabels[author].split(' ')[0]}</div>
						<div class="author-info">
							<p class="author-info-name">{authorProfiles[author].name}</p>
							<p class="author-info-meta">{authorProfiles[author].role}</p>
							<p class="author-info-bio">{authorProfiles[author].bio}</p>
						</div>
					</div>
				)}
				<div class="feed-header">
					<h2 class="feed-title">ライター</h2>
					<div class="filter-row">
						<a href={`${base}/blog/`}>すべて</a>
						{authors.map((a) => (
							<a href={`${base}/blog/author/${a}/`} class={a === author ? 'active' : ''}>{authorLabels[a]}</a>
						))}
					</div>
					<h2 class="feed-title" style="margin-top:1rem;">カテゴリ</h2>
					<div class="filter-row">
						<a href={`${base}/blog/`}>すべて</a>
						{categories.map((cat) => (
							<a href={`${base}/blog/category/${cat}/`}>{cat}</a>
						))}
					</div>
				</div>
				{page.data.length === 0 ? (
					<p style="color:rgb(var(--gray));padding:2rem 0;">この記事はまだありません。</p>
				) : (
					<ul>
						{page.data.map((post) => (
							<li>
								<a href={`${base}/blog/${post.id}/`}>
									<div class="card-meta">
										{post.data.author && (
											<span class="author-chip">
												{post.data.author === 'yuki' ? '☕ Yuki' : post.data.author === 'kz' ? '🛠️ kz' : '💼 Syun'}
											</span>
										)}
										<span class="category-chip">{post.data.category}</span>
										<span class="date-chip">
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span class="reading-time">約{readingTime(post.body)}分</span>
									</div>
									<h2 class="title">{post.data.title}</h2>
									{post.data.description && (
										<p class="description">{post.data.description}</p>
									)}
								</a>
							</li>
						))}
					</ul>
				)}
				{page.lastPage > 1 && (
					<nav class="pagination" aria-label="記事一覧のページ切り替え">
						{page.url.prev
							? <a href={page.url.prev}>← 新しい記事</a>
							: <span class="disabled">← 新しい記事</span>
						}
						<span class="page-info">{page.currentPage} / {page.lastPage}</span>
						{page.url.next
							? <a href={page.url.next}>古い記事 →</a>
							: <span class="disabled">古い記事 →</span>
						}
					</nav>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
