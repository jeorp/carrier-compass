---
import { getCollection } from 'astro:content';
import '../../styles/archive.css';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const authors = ['yuki', 'syun', 'kz'] as const;
const authorLabels: Record<string, string> = { syun: '💼 Syun', yuki: '☕ Yuki', kz: '🛠️ kz' };
const categories = ['転職', 'スキルアップ', '副業', '働き方'] as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const readingTime = (body: string) => Math.max(1, Math.ceil(body.length / 500));

export async function getStaticPaths({ paginate }: { paginate: Function }) {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: 8 });
}

const { page } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title={page.currentPage === 1 ? SITE_TITLE : `${SITE_TITLE} — ${page.currentPage}ページ目`}
			description={SITE_DESCRIPTION}
		/>

	</head>
	<body>
		<Header />
		<main class="archive">
      <div class="archive-heading"><p>THE JOURNAL</p><h1>ひと息つける、読みもの。</h1><span>仕事のこと、日々の気持ちのこと。今の気分に合う一篇を、ゆっくりと。</span></div>
			<section>
				<div class="feed-header">
					<h2 class="feed-title">ライター</h2>
					<div class="category-filters">
						<a href={`${base}/blog/`} class="active">すべて</a>
						{authors.map((a) => (
							<a href={`${base}/blog/author/${a}/`}>{authorLabels[a]}</a>
						))}
					</div>
					<h2 class="feed-title" style="margin-top:1rem;">カテゴリ</h2>
					<div class="category-filters">
						<a href={`${base}/blog/`} class="active">すべて</a>
						{categories.map((cat) => (
							<a href={`${base}/blog/category/${cat}/`}>{cat}</a>
						))}
					</div>
				</div>
				<ul>
					{page.data.map((post) => (
						<li>
							<a href={`${base}/blog/${post.id}/`}>
								<div class="card-meta">
									{post.data.author && (
										<span class="author-chip">
											{post.data.author === 'yuki' ? '☕ Yuki' : post.data.author === 'kz' ? '🛠️ kz' : '💼 Syun'}
										</span>
									)}
									{post.data.category && (
										<span class="category-chip">{post.data.category}</span>
									)}
									<span class="date-chip">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="reading-time">約{readingTime(post.body)}分</span>
								</div>
								<h2 class="title">{post.data.title}</h2>
								{post.data.description && (
									<p class="description">{post.data.description}</p>
								)}
							</a>
						</li>
					))}
				</ul>
				<nav class="pagination" aria-label="記事一覧のページ切り替え">
					{page.url.prev
						? <a href={page.url.prev}>← 新しい記事</a>
						: <span class="disabled">← 新しい記事</span>
					}
					<span class="page-info">{page.currentPage} / {page.lastPage}</span>
					{page.url.next
						? <a href={page.url.next}>古い記事 →</a>
						: <span class="disabled">古い記事 →</span>
					}
				</nav>
			</section>
		</main>
		<Footer />
	</body>
</html>
