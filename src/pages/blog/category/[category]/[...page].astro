---
import { getCollection } from 'astro:content';
import '../../../../styles/archive.css';
import BaseHead from '../../../../components/BaseHead.astro';
import Footer from '../../../../components/Footer.astro';
import FormattedDate from '../../../../components/FormattedDate.astro';
import Header from '../../../../components/Header.astro';
import { SITE_TITLE } from '../../../../consts';

const authors = ['yuki', 'syun', 'kz'] as const;
const authorLabels: Record<string, string> = { syun: '💼 Syun', yuki: '☕ Yuki', kz: '🛠️ kz' };
const categories = ['転職', 'スキルアップ', '副業', '働き方'] as const;

export async function getStaticPaths({ paginate }: { paginate: Function }) {
	const categories = ['転職', 'スキルアップ', '副業', '働き方'] as const;
	const posts = await getCollection('blog');
	return categories.flatMap((category) => {
		const filtered = posts
			.filter((p) => p.data.category === category)
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		return paginate(filtered, { params: { category }, pageSize: 8 });
	});
}

const { category } = Astro.params;
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const readingTime = (body: string) => Math.max(1, Math.ceil(body.length / 500));
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title={page.currentPage === 1 ? `${category} | ${SITE_TITLE}` : `${category} — ${page.currentPage}ページ目 | ${SITE_TITLE}`}
			description={`${category}に関する記事一覧`}
			noindex={true}
		/>

	</head>
	<body>
		<Header />
		<main class="archive">
      <div class="archive-heading"><p>THE JOURNAL</p><h1>{category}</h1><span>働く毎日と、これからを考える読みもの。</span></div>
			<section>
				<div class="feed-header">
					<h2 class="feed-title">ライター</h2>
					<div class="filter-row">
						<a href={`${base}/blog/`}>すべて</a>
						{authors.map((a) => (
							<a href={`${base}/blog/author/${a}/`}>{authorLabels[a]}</a>
						))}
					</div>
					<h2 class="feed-title" style="margin-top:1rem;">カテゴリ</h2>
					<div class="filter-row">
						<a href={`${base}/blog/`}>すべて</a>
						{categories.map((cat) => (
							<a href={`${base}/blog/category/${cat}/`} class={cat === category ? 'active' : ''}>{cat}</a>
						))}
					</div>
				</div>
				{page.data.length === 0 ? (
					<p style="color:rgb(var(--gray));padding:2rem 0;">このカテゴリの記事はまだありません。</p>
				) : (
					<ul>
						{page.data.map((post) => (
							<li>
								<a href={`${base}/blog/${post.id}/`}>
									<div class="card-meta">
										{post.data.author && (
											<span class="author-chip">
												{post.data.author === 'yuki' ? '☕ Yuki' : post.data.author === 'kz' ? '🛠️ kz' : '💼 Syun'}
											</span>
										)}
										<span class="category-chip">{post.data.category}</span>
										<span class="date-chip">
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span class="reading-time">約{readingTime(post.body)}分</span>
									</div>
									<h2 class="title">{post.data.title}</h2>
									{post.data.description && (
										<p class="description">{post.data.description}</p>
									)}
								</a>
							</li>
						))}
					</ul>
				)}
				{page.lastPage > 1 && (
					<nav class="pagination" aria-label="記事一覧のページ切り替え">
						{page.url.prev
							? <a href={page.url.prev}>← 新しい記事</a>
							: <span class="disabled">← 新しい記事</span>
						}
						<span class="page-info">{page.currentPage} / {page.lastPage}</span>
						{page.url.next
							? <a href={page.url.next}>古い記事 →</a>
							: <span class="disabled">古い記事 →</span>
						}
					</nav>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
