---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { isBlogPost?: boolean };

const { title, description, pubDate, updatedDate, heroImage, author, category, tags, related, isAffiliate, isBlogPost = false } = Astro.props;

const authors: Record<string, { name: string; bio: string; icon: string }> = {
	yuki: {
		name: 'Yuki',
		icon: '☕',
		bio: '職場の人間関係や働き方の迷いをテーマに、気持ちの整理や相談のヒントを届けます。',
	},
	syun: {
		name: 'Syun',
		icon: '💼',
		bio: '転職やキャリアの選び方をテーマに、迷いを整理し、次の一歩を考えるヒントを届けます。',
	},
	kz: {
		name: 'kz',
		icon: '🛠️',
		bio: 'このサイトの開発・運営を担当。エンジニアのキャリアや、副業・フリーランスをテーマに記事を編集しています。',
	},
};

const authorProfile = author ? authors[author] : null;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog');

// URLから現在記事のIDを取得して除外
const segments = Astro.url.pathname.split('/').filter(Boolean);
const currentId = segments[segments.length - 1];

const MAX_RELATED = 3;

const scoredPosts = (() => {
	const currentTags = tags ?? [];
	return allPosts
		.filter((p) => p.id !== currentId)
		.map((p) => {
			let score = 0;
			if (p.data.author === author) score += 3;
			if (p.data.category === category) score += 2;
			score += (p.data.tags ?? []).filter((t) => currentTags.includes(t)).length;
			return { post: p, score };
		})
		.filter(({ score }) => score > 0)
		.sort((a, b) => b.score - a.score)
		.map(({ post }) => post);
})();

const manualPosts = (related ?? [])
	.map((id) => allPosts.find((post) => post.id === id && id !== currentId))
	.filter((post): post is CollectionEntry<'blog'> => Boolean(post));
const candidatePosts = manualPosts.length ? manualPosts : scoredPosts;

const relatedPosts = candidatePosts.slice(0, MAX_RELATED);

const shareUrl = `https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const breadcrumbs = [
	{ name: 'ホーム', url: new URL(`${base}/`, Astro.site).href },
	{ name: '記事一覧', url: new URL(`${base}/blog/`, Astro.site).href },
	{ name: title, url: canonicalURL },
];
// Public dates are date-only editorial values; do not invent a publication time.
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	'@id': `${canonicalURL}#article`,
	mainEntityOfPage: canonicalURL,
	headline: title,
	description,
	datePublished: pubDate.toISOString().slice(0, 10),
	...(updatedDate && { dateModified: updatedDate.toISOString().slice(0, 10) }),
	inLanguage: 'ja',
	articleSection: category,
	// Attribute the site's content to the publication and preserve kz's disclosed editorial role.
	author: { '@type': 'Organization', name: SITE_TITLE, url: new URL(`${base}/about/`, Astro.site).href },
	editor: { '@type': 'Person', name: 'kz', url: new URL(`${base}/about/`, Astro.site).href },
	publisher: { '@type': 'Organization', name: SITE_TITLE, url: Astro.site?.href },
	...(heroImage && { image: [new URL(heroImage.src, Astro.site).href] }),
};
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: breadcrumbs.map((item, i) => ({ '@type': 'ListItem', position: i + 1, name: item.name, item: item.url })),
};
const jsonLd = JSON.stringify([articleSchema, breadcrumbSchema]).replace(/</g, '\\u003c');
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type={isBlogPost ? 'article' : 'website'} />
		{isBlogPost && <script type="application/ld+json" set:html={jsonLd} />}
		<style>
			.breadcrumbs { max-width: 720px; margin: 0 auto 16px; font-size: .75rem; }
			.breadcrumbs ol { display: flex; flex-wrap: wrap; gap: .35em .65em; list-style: none; padding: 0; margin: 0; }
			.breadcrumbs li { overflow-wrap: anywhere; }
			.breadcrumbs li + li::before { content: '/'; margin-right: .65em; color: rgb(var(--gray)); }
			.editor-credit { font-size: .75rem; color: rgb(var(--gray)); margin: .75em 0 0; }
			main {
				width: 100%;
				max-width: 100%;
				margin: 0 auto;
				padding: 48px 24px 72px;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: 100%;
				margin: auto;
				padding: 0;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 32px;
				padding: 24px 0;
				text-align: left;
				line-height: 1.8;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.title h1 {
				margin: 0 0 .7em;
				font-family: var(--serif);
				font-size: clamp(25px, 3.2vw, 36px);
				line-height: 1.65;
				letter-spacing: .03em;
			}
			.date {
				font-size: 12px;
				line-height: 1.8;
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: normal;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				justify-content: flex-start;
				margin-top: 0.75em;
			}
			.category {
				background: var(--accent);
				color: white;
				font-size: 0.75em;
				padding: 0.25em 0.75em;
				border-radius: 999px;
				font-weight: 700;
			}
			.tag {
				background: var(--tint);
				color: rgb(var(--gray-dark));
				font-size: 0.75em;
				padding: 0.25em 0.75em;
				border-radius: 999px;
				text-decoration: none;
				transition: background 0.15s ease;
			}
			.tag:hover {
				background: rgb(var(--gray));
				color: white;
			}
			.author-profile {
				display: flex;
				align-items: flex-start;
				gap: 1em;
				margin-top: 3em;
				padding: 1.5em;
				background: var(--tint);
				border-radius: 12px;
			}
			.author-icon {
				font-size: 2.5em;
				line-height: 1;
				flex-shrink: 0;
			}
			.author-name {
				font-weight: 700;
				margin-bottom: 0.25em;
			}
			.author-bio {
				font-size: 0.85em;
				color: rgb(var(--gray));
				margin: 0;
			}
			.author-link {
				display: inline-block;
				margin-top: 0.75em;
				font-size: 0.85em;
				color: var(--accent);
				text-decoration: none;
			}
			.author-link:hover {
				text-decoration: underline;
			}
			.related {
				margin-top: 2.5em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.related-title {
				font-size: 0.8rem;
				font-weight: 700;
				color: rgb(var(--gray));
				letter-spacing: 0.1em;
				text-transform: uppercase;
				margin: 0 0 1em;
			}
			.related-list {
				display: flex;
				flex-direction: column;
				gap: 0.75em;
			}
			.related-card {
				display: block;
				padding: 1em 1.2em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				text-decoration: none;
				color: inherit;
				transition: border-color 0.15s ease;
			}
			.related-card:hover {
				border-color: var(--accent);
			}
			.related-card-author {
				font-size: 0.75rem;
				color: rgb(var(--gray));
				margin-bottom: 0.3em;
			}
			.related-card-title {
				font-size: 0.95rem;
				font-weight: 700;
				line-height: 1.4;
				margin: 0;
			}
			.share {
				margin-top: 2.5em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
				display: flex;
				align-items: center;
				gap: 0.75em;
			}
			.share-label {
				font-size: 0.8rem;
				color: rgb(var(--gray));
				font-weight: 700;
				letter-spacing: 0.05em;
			}
			.share-x {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				padding: 0.5em 1.1em;
				border-radius: 999px;
				background: #000;
				color: white;
				font-size: 0.85rem;
				font-weight: 700;
				text-decoration: none;
				transition: opacity 0.15s ease;
			}
			.share-x:hover { opacity: 0.8; }
			.pr-notice {
				font-size: 0.78rem;
				color: rgb(var(--gray));
				margin: 0 0 1.5em;
			}
			@media (max-width: 720px) {
				main { padding: 24px 20px 48px; }
				.title { padding-top: 12px; }
				.author-profile {
					flex-direction: column;
					gap: 0.75em;
				}
				.author-icon {
					font-size: 1.8em;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			{isBlogPost && <nav class="breadcrumbs" aria-label="パンくずリスト"><ol>
				{breadcrumbs.map((item, i) => <li>{i === breadcrumbs.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.url}>{item.name}</a>}</li>)}
			</ol></nav>}
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" fetchpriority="high" loading="eager" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										最終更新日: <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{isBlogPost && <p class="editor-credit">編集：<a href={`${base}/about/`}>kz</a>{authorProfile && ` ／ 語り手：${authorProfile.name}`}</p>}
						<div class="meta">
							{category && <span class="category">{category}</span>}
							{tags && tags.map((tag) => <a href={`${base}/blog/tag/${tag}/`} class="tag">#{tag}</a>)}
						</div>
					</div>
					{isAffiliate && (
						<p class="pr-notice">※ 本記事はアフィリエイト広告を含みます。</p>
					)}
					<slot />
					{author && relatedPosts.length > 0 && (
						<div class="related">
							<p class="related-title">こんな記事も読まれています</p>
							<div class="related-list">
								{relatedPosts.map((p) => (
									<a class="related-card" href={`${base}/blog/${p.id}/`}>
										<div class="related-card-author">
											{p.data.author === 'yuki' ? '☕ Yuki' : p.data.author === 'kz' ? '🛠️ kz' : '💼 Syun'}
										</div>
										<p class="related-card-title">{p.data.title}</p>
									</a>
								))}
							</div>
						</div>
					)}
					{authorProfile && (
					<div class="author-profile">
						<div class="author-icon">{authorProfile.icon}</div>
						<div class="author-info">
							<div class="author-name">{authorProfile.name}</div>
							<p class="author-bio">{authorProfile.bio}</p>
						<a class="author-link" href={`${base}/blog/author/${author}/`}>{authorProfile.name}の記事をもっと読む →</a>
					</div>
				</div>
			)}
					{author && (
						<div class="share">
							<span class="share-label">シェア</span>
							<a class="share-x" href={shareUrl} target="_blank" rel="noopener noreferrer">
								𝕏 でポストする
							</a>
						</div>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
