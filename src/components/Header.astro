---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header>
	<nav aria-label="メインナビゲーション">
		<a class="brand" href={import.meta.env.BASE_URL}>
        <svg class="brand-mark" aria-hidden="true" width="34" height="34" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="17" stroke="currentColor"/><path d="m26 12-3 11-11 5 5-11Z" stroke="currentColor"/><path d="m26 12-9 5 6 6Z" fill="currentColor"/></svg>
        <span>{SITE_TITLE}<small>わたしと、仕事と、これから。</small></span>
      </a>
		<div class="internal-links">
			<HeaderLink href={`${base}/`}>ホーム</HeaderLink>
			<HeaderLink href={`${base}/blog/`}>ブログ</HeaderLink>
			<HeaderLink href={`${base}/about/`}>このサイトについて</HeaderLink>
		</div>
	</nav>
</header>

<nav class="bottom-nav" aria-label="メインナビゲーション">
	<HeaderLink href={`${base}/`}>
		<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
		<span>ホーム</span>
	</HeaderLink>
	<HeaderLink href={`${base}/blog/`}>
		<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
		<span>ブログ</span>
	</HeaderLink>
	<HeaderLink href={`${base}/about/`}>
		<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
		<span>について</span>
	</HeaderLink>
</nav>

<style>
header { border-bottom: 1px solid rgb(var(--gray-light)); background: var(--paper); padding: 0 28px; }
header nav { max-width: 1080px; min-height: 94px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
.brand { display: flex; align-items: center; gap: 12px; color: rgb(var(--black)); text-decoration: none; font-family: var(--serif); font-weight: 500; font-size: 21px; letter-spacing: .07em; line-height: 1.5; }
.brand-mark { color: var(--accent); flex-shrink: 0; }
.brand small { display: block; margin-top: 4px; font-family: sans-serif; font-size: 10px; font-weight: 400; letter-spacing: .12em; color: rgb(var(--gray)); }
.internal-links { display: flex; align-items: center; gap: 28px; }
.internal-links :global(a) { color: rgb(var(--gray)); font-size: 13px; padding: 12px 0; border-bottom: 1px solid transparent; }
.internal-links :global(a.active) { color: var(--accent); border-color: var(--accent); text-decoration: none; }
.bottom-nav { display: none; }
@media (max-width: 720px) {
 header { padding: 0 20px; }
 header nav { min-height: 76px; }
 .brand { font-size: 18px; gap: 10px; }
 .brand small { font-size: 9px; }
 .internal-links { display: none; }
 .bottom-nav { display: flex; position: fixed; bottom: 0; left: 0; right: 0; height: calc(64px + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background: var(--surface); border-top: 1px solid rgb(var(--gray-light)); z-index: 100; }
 .bottom-nav :global(a) { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; color: rgb(var(--gray)); font-size: 10px; text-decoration: none; }
 .bottom-nav :global(a.active) { color: var(--accent); }
 .bottom-nav :global(svg) { width: 20px; height: 20px; stroke-width: 1.5; }
}
</style>
