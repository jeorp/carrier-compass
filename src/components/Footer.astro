---
const today = new Date();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer>
	<p class="footer-brand">キャリアの羅針盤</p>
	<p class="footer-message">わたしの気持ちも、大切に。</p>
	<nav class="footer-links" aria-label="サイト情報">
		<a href={`${base}/about/`}>このサイトについて</a>
		<a href={`${base}/contact/`}>お問い合わせ</a>
		<a href={`${base}/privacy-policy/`}>プライバシーポリシー</a>
	</nav>
	<p class="copyright">&copy; {today.getFullYear()} キャリアの羅針盤. All rights reserved.</p>
</footer>
<style>
.footer-brand { font-family: var(--serif); font-weight: 700; font-size: 20px; color: rgb(var(--black)); margin: 0; }
.footer-message { font-size: 12px; margin: 8px 0 28px; }
	footer {
		padding: 48px 24px;
		border-top: 1px solid rgb(var(--gray-light));
		background: #f7ebef;
		color: rgb(var(--gray));
		text-align: center;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.5em 1.5em;
		margin-bottom: 1em;
	}
	.footer-links a {
		font-size: 0.8rem;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.footer-links a:hover {
		text-decoration: underline;
	}
	.copyright {
		font-size: 0.8rem;
		margin: 0;
	}
</style>
