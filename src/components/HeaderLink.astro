---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const hrefStr = typeof href === 'string' ? href : href?.toString() ?? '';
const pathname = Astro.url.pathname;
const normalizedHref = hrefStr.replace(/\/$/, '') || '/';
const normalizedPath = pathname.replace(/\/$/, '') || '/';
const isActive = normalizedPath === normalizedHref || (normalizedHref !== '/' && normalizedPath.startsWith(normalizedHref + '/'));
---

<a href={hrefStr} aria-current={isActive ? (normalizedPath === normalizedHref ? "page" : "true") : undefined} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
